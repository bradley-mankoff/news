{
  "repo": "bradley-mankoff/news",
  "project_owner": "bradley-mankoff",
  "project_number": 1,
  "status_field": "Status",
  "default_lane": "Backlog",
  "poll_interval_seconds": 45,
  "poll_timeout_seconds": 300,
  "state_file": "automation/state.json",
  "max_concurrent_workflows": 10,
  "runnable_label": "runnable",
  "decision_only": {
    "label": "decision-only",
    "move_to": "Needs Input"
  },
  "hooks": {
    "after_integration_merge": [
      "python3",
      "automation/news_ui_runtime.py",
      "sync"
    ]
  },
  "lanes": {
    "Backlog": "backlog",
    "Todo": "todo",
    "In Progress": "in_progress",
    "Blocked": "blocked",
    "Needs Input": "needs_input",
    "Ready for Review": "ready",
    "In Review": "review",
    "Done": "done"
  },
  "dispatch": {
    "todo": {
      "default": "archon-fix-github-issue",
      "move_to": "In Progress",
      "complete_move_to": "Ready for Review",
      "merge_develop_base": "develop",
      "conflict_fix_workflow": "archon-fix-develop-conflicts",
      "label_overrides": {
        "bug": "archon-fix-github-issue",
        "feature": "archon-idea-to-pr",
        "enhancement": "archon-idea-to-pr"
      }
    },
    "review": {
      "workflow": "archon-smart-pr-review",
      "ship_to": "main",
      "merge_ship_on_approve": true,
      "done_lane": "Done",
      "conflict_fix_workflow": "archon-fix-ship-conflicts"
    }
  }
}